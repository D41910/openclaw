import { createHash } from "node:crypto";
import type { SqliteSchemaCatalog } from "../../src/infra/sqlite-schema-catalog.ts";
import { formatGeneratedModule } from "./format-generated-module.mts";
import { readSqliteSchemaCatalog } from "./sqlite-schema-catalog.mts";
import type { SqliteSchemaInput } from "./sqlite-schema-inputs.mts";

type GeneratedCatalog = {
  id: string;
  hash: string;
  catalog: SqliteSchemaCatalog;
};

const GENERATED_HEADER = "// Generated by pnpm db:postgres:gen. Do not edit.";
const CATALOG_TYPE_IMPORT =
  'import type { SqliteSchemaCatalog } from "../../infra/sqlite-schema-catalog.js";';

function storeReaderName(store: SqliteSchemaInput["store"]): string {
  return `readSqlite${store === "state" ? "State" : "Agent"}Catalog`;
}

function emitStoreCatalogs(
  store: SqliteSchemaInput["store"],
  catalogs: GeneratedCatalog[],
): string {
  const tables: SqliteSchemaCatalog["tables"][number][] = [];
  const tableIndexes = new Map<string, number>();
  const entries = catalogs.map(({ id, hash, catalog }) => {
    const references = catalog.tables.map((table) => {
      const key = JSON.stringify(table);
      let index = tableIndexes.get(key);
      if (index === undefined) {
        index = tables.length;
        tableIndexes.set(key, index);
        tables.push(table);
      }
      return `tables[${index}]!`;
    });
    return `// ${id}\n[${JSON.stringify(hash)}, { tables: [${references.join(", ")}], views: ${JSON.stringify(catalog.views)} }]`;
  });
  return `${GENERATED_HEADER}
${CATALOG_TYPE_IMPORT}

let catalogs: ReadonlyMap<string, SqliteSchemaCatalog> | undefined;

export function ${storeReaderName(store)}(hash: string): SqliteSchemaCatalog | undefined {
  if (!catalogs) {
    const tables: SqliteSchemaCatalog["tables"] = ${JSON.stringify(tables, null, 2)};
    catalogs = new Map<string, SqliteSchemaCatalog>([
      ${entries.join(",\n")}
    ]);
  }
  return catalogs.get(hash);
}
`;
}

/** Evaluate declared DDL only while generating artifacts; runtime loads the resulting facts. */
export async function generateSqliteSchemaCatalogs(
  inputs: readonly SqliteSchemaInput[],
  repoRoot: string,
): Promise<Record<string, string>> {
  const { DatabaseSync } = await import("node:sqlite");
  const grouped: Record<SqliteSchemaInput["store"], GeneratedCatalog[]> = {
    state: [],
    agent: [],
  };
  const seen = new Set<string>();
  for (const { id, store, sql } of inputs) {
    if (seen.has(sql)) {
      continue;
    }
    const hash = createHash("sha256").update(sql).digest("hex");
    const db = new DatabaseSync(":memory:");
    try {
      db.exec(sql);
      grouped[store].push({ id, hash, catalog: readSqliteSchemaCatalog(db) });
      seen.add(sql);
    } catch (error) {
      throw new Error(`Could not generate SQLite schema catalog for ${id}`, { cause: error });
    } finally {
      db.close();
    }
  }

  const files: Record<string, string> = {};
  const stores = ["state", "agent"] as const;
  for (const store of stores) {
    const file = `sqlite-${store}-catalogs.ts`;
    files[file] = formatGeneratedModule(emitStoreCatalogs(store, grouped[store]), {
      repoRoot,
      outputPath: file,
      errorLabel: `SQLite ${store} catalogs`,
    });
  }
  files["sqlite-catalogs.ts"] = formatGeneratedModule(
    `${GENERATED_HEADER}
import { createHash } from "node:crypto";
${CATALOG_TYPE_IMPORT}
${stores.map((store) => `import { ${storeReaderName(store)} } from "./sqlite-${store}-catalogs.js";`).join("\n")}

export function readGeneratedSqliteCatalog(schemaSql: string): SqliteSchemaCatalog | undefined {
  const hash = createHash("sha256").update(schemaSql).digest("hex");
  switch (hash) {
    ${stores
      .filter((store) => grouped[store].length > 0)
      .map(
        (store) =>
          `${grouped[store].map(({ hash }) => `case ${JSON.stringify(hash)}:`).join("\n")}\nreturn ${storeReaderName(store)}(hash);`,
      )
      .join("\n")}
    default:
      return undefined;
  }
}
`,
    { repoRoot, outputPath: "sqlite-catalogs.ts", errorLabel: "SQLite catalog dispatcher" },
  );
  return files;
}
